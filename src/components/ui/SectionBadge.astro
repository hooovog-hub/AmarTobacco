---
/** Red numbered badge with a gold crown — the page marker used on every presentation slide. */
interface Props {
  number: number;
  class?: string;
}
const { number, class: className } = Astro.props;
---

<span class:list={['badge', className]} aria-hidden="true">
  <svg class="badge__crown" viewBox="0 0 40 20" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M2 18h36l2-13-9 6-5-9-6 8-6-8-5 9-9-6z"
      fill="#f2b437"
      stroke="#c88a1c"
      stroke-width="1"
      stroke-linejoin="round"
    ></path>
    <circle cx="20" cy="2.2" r="2" fill="#f2b437"></circle>
  </svg>
  <span class="badge__num">{String(number)}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    width: 2.6rem;
  }
  .badge__crown {
    width: 2.1rem;
    margin-bottom: -0.15rem;
  }
  .badge__num {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1 / 1.1;
    background: var(--c-red);
    color: var(--c-white);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1;
    border-radius: 0.35rem 0.35rem 0.6rem 0.6rem;
    box-shadow: 0 6px 20px rgb(232 20 30 / 0.35);
  }
</style>
