---
import { Image } from 'astro:assets';
import type { Dictionary } from '@/i18n';
import { SECTION_IDS } from '@/config/site';
import packsGrid from '@/assets/images/packs-black-grid.jpg';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const s = t.specs;
---

<section id={SECTION_IDS.specs} class="specs-section">
  <div class="specs-section__media">
    <Image
      src={packsGrid}
      alt={s.imageAlt}
      widths={[800, 1400, 2000]}
      sizes="(max-width: 900px) 100vw, 70vw"
      class="specs-section__img"
    />
    <p class="specs-section__tag">
      <span>{t.about.format}:</span>
      <span>{t.about.tar}: 4 mg</span>
      <span>{t.about.nicotine}: 0.4 mg</span>
    </p>
  </div>

  <div class="specs-section__panel">
    <div class="specs-section__copy" data-reveal>
      <span class="kicker">{s.kicker}</span>
      <h2 class="title">{s.title}</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">{s.parameter}</th>
              <th scope="col">{s.specification}</th>
            </tr>
          </thead>
          <tbody>
            {s.rows.map(([label, value]) => (
              <tr>
                <th scope="row">{label}</th>
                <td>{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="specs-section__note">{s.note}</p>
    </div>
  </div>
</section>

<style>
  .specs-section {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 46%) 1fr;
    min-height: min(100vh, 960px);
    background: var(--c-black);
    overflow: hidden;
  }
  .specs-section__media {
    position: absolute;
    inset: 0 0 0 30%;
  }
  .specs-section__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .specs-section__tag {
    position: absolute;
    top: calc(var(--header-h) + 1rem);
    right: var(--gutter);
    display: grid;
    padding-left: 0.9rem;
    border-left: 2px solid var(--c-white);
    font-weight: 800;
    font-size: var(--fs-lg);
    text-transform: uppercase;
    line-height: 1.3;
  }
  .specs-section__panel {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: var(--section-y) clamp(1.5rem, 4vw, 4rem) var(--section-y) var(--gutter);
    background: var(--c-black);
    border-radius: 0 var(--radius-panel) var(--radius-panel) 0;
  }
  .specs-section__copy {
    display: grid;
    gap: 1.75rem;
    width: min(100%, 34rem);
  }
  .table-wrap {
    overflow: hidden;
    border: 1px solid var(--c-line-dark);
    border-radius: 1.25rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  th,
  td {
    padding: 0.75rem 1.1rem;
    text-align: left;
    border-bottom: 1px solid var(--c-line-dark);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  thead th {
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-gold);
    background: rgb(255 255 255 / 0.04);
  }
  tbody th {
    font-weight: 500;
    opacity: 0.75;
  }
  tbody td {
    font-weight: 700;
  }
  tbody tr {
    transition: background-color 0.2s;
  }
  tbody tr:hover {
    background: rgb(255 255 255 / 0.04);
  }
  .specs-section__note {
    font-size: var(--fs-sm);
    opacity: 0.75;
  }

  @media (max-width: 900px) {
    .specs-section {
      grid-template-columns: 1fr;
      grid-template-rows: 60vw auto;
      min-height: 0;
    }
    .specs-section__media {
      position: relative;
      inset: auto;
    }
    .specs-section__tag {
      top: 1rem;
      font-size: var(--fs-sm);
    }
    .specs-section__panel {
      margin-top: calc(var(--radius-panel) * -1);
      justify-content: flex-start;
      padding: 3.5rem var(--gutter) 5rem;
      border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    }
  }
</style>
