---
import { Image } from 'astro:assets';
import type { Dictionary } from '@/i18n';
import { SECTION_IDS } from '@/config/site';
import Wordmark from '@/components/ui/Wordmark.astro';
import portrait from '@/assets/images/hero-portrait.jpg';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="hero">
  <div class="hero__media">
    <Image
      src={portrait}
      alt={t.hero.imageAlt}
      widths={[640, 960, 1400, 2000]}
      sizes="(max-width: 900px) 100vw, 60vw"
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
  </div>

  <div class="hero__panel">
    <div class="hero__content">
      <p class="hero__eyebrow">{t.hero.eyebrow}</p>
      <h1 class="hero__heading">
        <span class="hero__wordmark">
          <Wordmark label="AMAR" tone="bright" />
        </span>
        <span class="hero__title">{t.hero.title}</span>
      </h1>
      <p class="hero__body">{t.hero.body}</p>
      <div class="hero__actions">
        <a class="btn btn--dark" href={`#${SECTION_IDS.partner}`}>
          {t.hero.ctaPrimary}
        </a>
        <a class="btn btn--ghost" href={`#${SECTION_IDS.about}`}>
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>
  </div>
</section>

<section class="stats" aria-label="AMAR in numbers">
  <ul class="stats__list container">
    {t.stats.map((s) => (
      <li class="stats__item" data-reveal>
        <span class="stats__value gold-text">{s.value}</span>
        <span class="stats__label">{s.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 46%) 1fr;
    min-height: 100svh;
    background: var(--c-black);
    overflow: hidden;
  }
  .hero__media {
    position: absolute;
    inset: 0 0 0 30%;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
    filter: grayscale(1) contrast(1.05);
    animation: hero-zoom 14s var(--ease) both;
  }
  .hero__panel {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: calc(var(--header-h) + 3rem) clamp(1.5rem, 4vw, 4.5rem) 4rem var(--gutter);
    background: var(--c-red);
    border-radius: 0 var(--radius-panel) var(--radius-panel) 0;
    box-shadow: 30px 0 80px rgb(0 0 0 / 0.35);
  }
  .hero__content {
    display: grid;
    gap: 1.75rem;
    width: min(100%, 32rem);
    animation: hero-in 1.2s var(--ease) both;
  }
  .hero__eyebrow {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .hero__heading {
    display: grid;
    gap: 2rem;
  }
  .hero__wordmark {
    display: block;
    width: min(100%, 26rem);
    filter: drop-shadow(0 4px 18px rgb(0 0 0 / 0.25));
  }
  .hero__title {
    font-size: clamp(1.4rem, 1rem + 1.6vw, 2.25rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.15;
  }
  .hero__body {
    max-width: 26rem;
    font-size: var(--fs-lg);
    opacity: 0.92;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stats {
    background: var(--c-black);
    border-bottom: 1px solid var(--c-line-dark);
  }
  .stats__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    padding-block: 3.5rem;
  }
  .stats__item {
    display: grid;
    gap: 0.35rem;
    padding-inline: 1.5rem;
    border-left: 1px solid var(--c-line-dark);
  }
  .stats__item:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stats__value {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.4rem);
    font-weight: 800;
    line-height: 1;
  }
  .stats__label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.08);
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: 62svh auto;
      min-height: 0;
    }
    .hero__media {
      position: relative;
      inset: auto;
    }
    .hero__panel {
      margin-top: calc(var(--radius-panel) * -1);
      padding: 3rem var(--gutter) 5rem;
      justify-content: flex-start;
      border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    }
    .stats__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 0;
    }
    .stats__item:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
