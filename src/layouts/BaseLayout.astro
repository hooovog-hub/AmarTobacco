---
import '@fontsource-variable/montserrat';
import '@fontsource/noto-sans-armenian/400.css';
import '@fontsource/noto-sans-armenian/600.css';
import '@fontsource/noto-sans-armenian/800.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@/styles/global.css';

import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { LOCALES, getDictionary, stripLocale, type Locale } from '@/i18n';
import { SITE } from '@/config/site';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AgeGate from '@/components/AgeGate.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Set on pages that should not be indexed (e.g. 404). */
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const t = getDictionary(locale);
const pageTitle = title ? `${title} — ${SITE.name}` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const path = stripLocale(Astro.url.pathname);
const canonical = getAbsoluteLocaleUrl(locale, path === '/' ? '' : path.slice(1));
const ogImage = new URL('/og-image.jpg', SITE.url).href;
const ageScript = `(function(){var d=document.documentElement;d.classList.add('js');try{var v=Number(localStorage.getItem(${JSON.stringify(SITE.ageStorageKey)}));if(v&&v>Date.now())d.classList.add('age-ok');}catch(e){}})();`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {!noindex &&
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={getAbsoluteLocaleUrl(l, path === '/' ? '' : path.slice(1))}
        />
      ))}
    {!noindex && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={getAbsoluteLocaleUrl('en', path === '/' ? '' : path.slice(1))}
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#050505" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline set:html={ageScript} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.a11y.skip}
    </a>
    <AgeGate locale={locale} />
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // Reveal-on-scroll for elements marked with [data-reveal].
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
