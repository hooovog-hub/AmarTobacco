---
/**
 * 18+ age gate. Shown only when JS is available and no valid confirmation is stored;
 * the inline script in BaseLayout sets `html.age-ok` before first paint to avoid a flash.
 */
import { Image } from 'astro:assets';
import { getDictionary, type Locale } from '@/i18n';
import { SITE } from '@/config/site';
import Wordmark from '@/components/ui/Wordmark.astro';
import crest from '@/assets/images/crest.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<div
  class="age"
  role="dialog"
  aria-modal="true"
  aria-labelledby="age-title"
  aria-describedby="age-question"
  data-age-gate
  data-storage-key={SITE.ageStorageKey}
  data-remember-days={SITE.ageRememberDays}
>
  <div class="age__card">
    <Image src={crest} alt="" width={180} class="age__crest" loading="eager" />
    <div class="age__wordmark">
      <Wordmark label="" />
    </div>
    <h2 id="age-title" class="age__title">
      {t.ageGate.title}
    </h2>
    <p id="age-question" class="age__question">
      {t.ageGate.question}
    </p>
    <div class="age__actions" data-age-actions>
      <button type="button" class="btn btn--red" data-age-confirm>
        {t.ageGate.confirm}
      </button>
      <button type="button" class="btn btn--ghost" data-age-deny>
        {t.ageGate.deny}
      </button>
    </div>
    <p class="age__denied" role="alert" hidden data-age-denied>
      {t.ageGate.denied}
    </p>
    <p class="age__note">{t.ageGate.note}</p>
  </div>
</div>

<script>
  const gate = document.querySelector<HTMLElement>('[data-age-gate]');
  if (gate && !document.documentElement.classList.contains('age-ok')) {
    const key = gate.dataset.storageKey!;
    const days = Number(gate.dataset.rememberDays);
    const confirm = gate.querySelector<HTMLButtonElement>('[data-age-confirm]')!;
    const deny = gate.querySelector<HTMLButtonElement>('[data-age-deny]')!;

    document.documentElement.classList.add('age-locked');
    confirm.focus();

    confirm.addEventListener('click', () => {
      try {
        localStorage.setItem(key, String(Date.now() + days * 864e5));
      } catch {
        /* storage unavailable (private mode) — confirm for this page view only */
      }
      document.documentElement.classList.add('age-ok');
      document.documentElement.classList.remove('age-locked');
    });

    deny.addEventListener('click', () => {
      gate.querySelector<HTMLElement>('[data-age-actions]')!.hidden = true;
      gate.querySelector<HTMLElement>('[data-age-denied]')!.hidden = false;
    });

    // Keep focus inside the dialog.
    gate.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusable = [...gate.querySelectorAll<HTMLElement>('button:not([hidden])')].filter(
        (el) => el.offsetParent !== null,
      );
      if (!focusable.length) return e.preventDefault();
      const first = focusable[0]!;
      const last = focusable[focusable.length - 1]!;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>

<style>
  .age {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    place-items: center;
    padding: var(--gutter);
    background:
      radial-gradient(ellipse at 50% 30%, rgb(232 20 30 / 0.18), transparent 60%), rgb(5 5 5 / 0.97);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    overflow-y: auto;
  }
  :global(html.js:not(.age-ok)) .age {
    display: grid;
  }
  :global(html.age-locked) {
    overflow: hidden;
  }
  .age__card {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    width: min(100%, 32rem);
    text-align: center;
    animation: age-in 0.8s var(--ease) both;
  }
  .age__crest {
    width: 8rem;
  }
  .age__wordmark {
    width: min(70%, 16rem);
  }
  .age__title {
    font-size: var(--fs-xl);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .age__question {
    opacity: 0.85;
  }
  .age__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .age__denied {
    padding: 1rem 1.25rem;
    border: 1px solid var(--c-red);
    border-radius: var(--radius-md);
    font-weight: 600;
  }
  .age__note {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  @keyframes age-in {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.98);
    }
  }
</style>
