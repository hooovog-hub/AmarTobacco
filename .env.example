# Resend API key (https://resend.com/api-keys). Without it the contact form returns a friendly
# "please email us directly" error instead of sending.
RESEND_API_KEY=

# Where partner inquiries are delivered.
CONTACT_TO_EMAIL=amartobacco.arm@gmail.com

# Sender address. Must be on a domain verified in Resend (e.g. "AMAR <noreply@amartobacco.com>").
# The default onboarding@resend.dev sender only delivers to the Resend account owner's address.
CONTACT_FROM_EMAIL="AMAR Website <onboarding@resend.dev>"
