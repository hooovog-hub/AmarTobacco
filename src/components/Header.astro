---
import { getDictionary, localizePath, type Locale } from '@/i18n';
import { SECTION_IDS } from '@/config/site';
import Wordmark from '@/components/ui/Wordmark.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const home = localizePath(locale);
const links = [
  { href: `${home}#${SECTION_IDS.about}`, label: t.nav.about },
  { href: `${home}#${SECTION_IDS.blend}`, label: t.nav.blend },
  { href: `${home}#${SECTION_IDS.manufacturing}`, label: t.nav.production },
  { href: `${home}#${SECTION_IDS.specs}`, label: t.nav.specs },
  { href: `${home}#${SECTION_IDS.partner}`, label: t.nav.partner },
];
---

<header class="header" data-header>
  <div class="header__inner container">
    <a class="header__logo" href={home} aria-label={t.a11y.home}>
      <Wordmark label="" />
    </a>

    <nav class="header__nav" id="site-nav" aria-label="Main" data-nav>
      <ul class="header__links">
        {links.map((l) => (
          <li>
            <a href={l.href} data-nav-link>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="header__mobile-extra">
        <LanguageSwitcher locale={locale} label={t.a11y.language} />
      </div>
    </nav>

    <div class="header__actions">
      <div class="header__lang">
        <LanguageSwitcher locale={locale} label={t.a11y.language} />
      </div>
      <a class="btn btn--red header__cta" href={`${home}#${SECTION_IDS.partner}`}>
        {t.nav.cta}
      </a>
      <button
        class="header__toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        data-open-label={t.a11y.openMenu}
        data-close-label={t.a11y.closeMenu}
        aria-label={t.a11y.openMenu}
        data-nav-toggle
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!header || !toggle) return;
    header.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('nav-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute(
      'aria-label',
      (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '',
    );
  };
  toggle?.addEventListener('click', () => setOpen(!header?.classList.contains('is-open')));
  document
    .querySelectorAll('[data-nav-link]')
    .forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    /* keeps nav legible over bright photos before the solid bar kicks in */
    background: linear-gradient(rgb(0 0 0 / 0.55), rgb(0 0 0 / 0));
    transition:
      background-color 0.4s var(--ease),
      backdrop-filter 0.4s;
  }
  .header.is-scrolled,
  .header.is-open {
    background: rgb(5 5 5 / 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--c-line-dark);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
  }
  .header__logo {
    flex: none;
    width: 7.5rem;
  }
  .header__nav {
    margin-inline: auto;
  }
  .header__links {
    display: flex;
    gap: 2rem;
    list-style: none;
    padding: 0;
  }
  .header__links a {
    position: relative;
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  .header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 1px;
    background: var(--c-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .header__links a:hover::after {
    transform: scaleX(1);
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
  }
  .header__cta {
    min-height: 2.6rem;
    padding: 0.55rem 1.2rem;
    font-size: var(--fs-xs);
  }
  .header__mobile-extra,
  .header__toggle {
    display: none;
  }

  @media (max-width: 1080px) {
    .header__links {
      gap: 1.25rem;
    }
    .header__lang {
      display: none;
    }
    .header__mobile-extra {
      display: block;
    }
  }

  @media (max-width: 900px) {
    .header__toggle {
      display: grid;
      place-content: center;
      gap: 6px;
      width: 2.75rem;
      height: 2.75rem;
      background: none;
      border: 1px solid var(--c-line-dark);
      border-radius: 50%;
    }
    .header__toggle span {
      width: 1.1rem;
      height: 2px;
      background: currentColor;
      transition: transform 0.3s var(--ease);
    }
    .header.is-open .header__toggle span:first-child {
      transform: translateY(4px) rotate(45deg);
    }
    .header.is-open .header__toggle span:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }
    .header__nav {
      /* absolute, not fixed: the header's backdrop-filter makes it the containing block */
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - var(--header-h));
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 2.5rem var(--gutter);
      background: var(--c-black);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-1rem);
      transition:
        opacity 0.35s var(--ease),
        transform 0.35s var(--ease),
        visibility 0.35s;
    }
    .header.is-open .header__nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
    .header__links {
      flex-direction: column;
      gap: 1.4rem;
    }
    .header__links a {
      font-size: 1.6rem;
      font-weight: 800;
      text-transform: uppercase;
    }
  }

  @media (max-width: 520px) {
    .header__cta {
      display: none;
    }
  }

  :global(html.nav-open) {
    overflow: hidden;
  }
</style>
